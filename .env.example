POSTGRES_DB=monster_game
POSTGRES_USER=monster_game
POSTGRES_PASSWORD=monster_game_password
BACKEND_PORT=5001
FRONTEND_PORT=5173
FRONTEND_PUBLIC_BIND=0.0.0.0
FRONTEND_PUBLIC_PORT=80
DATABASE_URL=postgresql://monster_game:monster_game_password@postgres:5432/monster_game
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_IP_LIMIT=3
REGISTRATION_IP_WINDOW_SECONDS=86400
MAX_CONTENT_LENGTH=1048576
MAX_USERNAME_LENGTH=32
MAX_PASSWORD_LENGTH=128
MAX_INSULT_LENGTH=1000
AUTH_TOKEN_TTL_DAYS=30
VITE_API_URL=http://localhost:5001/api
